# Copy this file to .env.production on the server and replace every secret.

HTTP_PORT=80
CLIENT_PUBLIC_URL=http://your-domain.com
REACT_APP_GATEWAY_API_URL=/api
REACT_APP_API_TIMEOUT=10000

JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_internal_token
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

AUTH_MYSQL_ROOT_PASSWORD=replace_with_auth_mysql_password
AUTH_MYSQL_DATABASE=auth-service

USER_MYSQL_ROOT_PASSWORD=replace_with_user_mysql_password
USER_MYSQL_DATABASE=user-service

PRODUCT_MYSQL_ROOT_PASSWORD=replace_with_product_mysql_password
PRODUCT_MYSQL_DATABASE=product-service

BOOKING_SERVICE_URL=http://booking-service:8002
ORDER_SERVICE_URL=http://booking-service:8002
BOOKING_MYSQL_ROOT_PASSWORD=replace_with_booking_mysql_password
BOOKING_MYSQL_DATABASE=booking-service

PAYMENT_SERVICE_URL=http://payment-service:8003
PAYMENT_MYSQL_ROOT_PASSWORD=replace_with_payment_mysql_password
PAYMENT_MYSQL_DATABASE=payment-service

# never: do not seed product data
# empty: seed sample product data only when the products table is empty
# reseed: clear and seed product data on every product-service startup
PRODUCT_SEED_MODE=never

EMAIL_USER=
EMAIL_PASS=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
